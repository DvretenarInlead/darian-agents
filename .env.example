# ============================================================================
# darian-agents — environment configuration template
# Copy to .env for local dev. NEVER commit a real .env (see .gitignore).
# In production these are supplied as DigitalOcean App Platform secrets.
# ============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Postgres (DO Managed Postgres) ---
# The application connects with a least-privilege role. The audit_log table is
# granted INSERT + SELECT only for this role (no UPDATE/DELETE) — see migrations.
DATABASE_URL=postgres://app:password@localhost:5432/darian_agents
DATABASE_SSL=false
# Managed-Postgres CA certificate (PEM, or base64 of the PEM). With DATABASE_SSL=true:
# set → full TLS verification against this CA (download from the DO cluster page);
# unset → encrypted but unverified (works on DO's private network; set the CA to harden).
DATABASE_CA_CERT=
# Per-instance pool cap. Across all web + worker instances keep the total under
# Postgres max_connections; front with PgBouncer (transaction mode) at scale.
DATABASE_POOL_MAX=10

# --- App-level envelope encryption ---
# Master key (base64, 32 bytes) used to wrap per-record data keys for the most
# sensitive columns (raw transcripts, repo content, owner/MFA metadata).
# Rotate on the documented cadence; keep prior key versions for decryption.
ENVELOPE_MASTER_KEY=
ENVELOPE_KEY_VERSION=1

# --- Anthropic (commercial API terms — no training on inputs) ---
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-8
# Fast model for the voice assistant (spoken answers want latency, not depth).
ASSISTANT_MODEL=claude-haiku-4-5-20251001

# --- Fireflies (Product A ingestion) ---
FIREFLIES_API_KEY=
# Backstop poller: the worker also lists recent transcripts on this interval
# (minutes) and ingests anything a missed webhook would drop. 0 disables it.
FIREFLIES_POLL_MINUTES=10
# Instant push trigger — shared secret for inbound webhook HMAC verification.
FIREFLIES_WEBHOOK_SECRET=
# Reject webhook payloads whose timestamp is older than this (seconds).
WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300

# --- HubSpot (Agent CLI default; Projects API version-pinned fallback) ---
HUBSPOT_ACCESS_TOKEN=
# Broad-permission service key — admin-mode only, gated behind a dedicated role.
HUBSPOT_SERVICE_KEY=
HUBSPOT_PROJECTS_API_VERSION=2026-03

# --- GitHub (Product B repo scoring) ---
GITHUB_TOKEN=

# --- Personal assistant (voice HUD at /assistant) ---
# Shared secret the HUD sends as a Bearer token; min 16 chars (e.g. openssl rand -base64 24).
# The /assistant routes register only when this AND ANTHROPIC_API_KEY are set.
ASSISTANT_ACCESS_TOKEN=
# Deny-by-default IP allowlist for the assistant (page + API). CSV of IPs or
# CIDRs, IPv4/IPv6 (e.g. 203.0.113.7,10.0.0.0/8,2001:db8::/48). Empty = nobody.
ASSISTANT_ALLOWED_IPS=
# ElevenLabs voice (assistant ears + mouth). Unset → browser voice fallback.
# Remember to add api.elevenlabs.io to EGRESS_ALLOWLIST when enabling.
ELEVENLABS_API_KEY=
# Public voice identifier from the ElevenLabs Voice Library (not a secret).
# Leave empty to use the built-in default voice.
ELEVENLABS_VOICE_ID=
# Trust X-Forwarded-For from the fronting proxy/LB. REQUIRED in production on
# DO App Platform so the allowlist sees the real client IP, not the LB's.
TRUST_PROXY=false

# --- Console auth / sessions ---
SESSION_ACCESS_TTL_SEC=900
SESSION_IDLE_TTL_SEC=1800
SESSION_ABSOLUTE_TTL_SEC=43200
SUDO_REAUTH_WINDOW_SEC=300

# --- Egress allowlist (comma-separated hostnames the workers may reach) ---
EGRESS_ALLOWLIST=api.anthropic.com,api.fireflies.ai,api.hubapi.com,api.github.com,api.elevenlabs.io

# --- Off-box audit shipping ---
AUDIT_SHIP_ENDPOINT=
AUDIT_SHIP_TOKEN=
